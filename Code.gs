// كلمة مرور المدير لا تُخزَّن داخل الشيفرة. عيّنها من Apps Script > Project Settings > Script Properties
// بالمفتاح: ADMIN_PASSWORD
var ADMIN_PASSWORD_PROPERTY = 'ADMIN_PASSWORD';
var WORK_DAYS = [0, 1, 2, 3, 4];   // الأحد=0 ... الخميس=4 (الجمعة=5 والسبت=6 عطلة)
var OPEN_MINUTES = 8 * 60;         // 8:00 صباحاً
var CLOSE_MINUTES = 14 * 60;       // 2:00 ظهراً

var LETTERHEAD_PNG_B64 = ""; // نفس صورة الترويسة الرسمية المستخدمة في الصفحة
var REQUESTS_SHEET = "Requests";
var OPTIONS_SHEET = "Options";

// الخيارات الافتراضية لصفة المستقبِل (قابلة للتوسعة من الموظفين أثناء الاستخدام)
var DEFAULT_HOST_TITLES = [
  "معالي الوزير",
  "مستشار الوزير",
  "رئيس الدائرة",
  "معاون رئيس الدائرة",
  "رئيس قسم",
  "وكيل الوزارة للعلاقات الثنائية",
  "وكيل الوزارة للشؤون الادارية والفنية",
  "وكيل الوزارة للعلاقات المتعددة الاطراف والشؤون القانونية",
  "وكيل الوزارة للتخطيط السياسي"
];

// القاعات الثابتة (قابلة للتوسعة أيضاً إن احتاج المدير كتابة قاعة جديدة)
var DEFAULT_ROOMS = [
  "بابل", "سومر", "الطابق الخامس", "الطابق السادس", "قاعة المعهد",
  "قاعة الطابق الأرضي", "مكتب السفير", "مكتب الوكيل", "مكتب الوزير"
];

// تصنيف صفات المستقبِل ضمن الأقسام الأربعة لجدول المواعيد اليومي الرسمي
var CATEGORY_LABELS = {
  1: 'الفئة الأولى: الوزير',
  2: 'الفئة الثانية: الوكلاء',
  3: 'الفئة الثالثة: رؤساء الدوائر ومعاونوهم',
  4: 'الفئة الرابعة: رؤساء الأقسام وباقي موظفي الوزارة'
};
var CATEGORY_VALUES = [CATEGORY_LABELS[1], CATEGORY_LABELS[2], CATEGORY_LABELS[3], CATEGORY_LABELS[4]];

// تصنيف قديم يُستخدم فقط مع الطلبات الموجودة قبل إضافة حقل الفئة.
var SECTION_TITLES = {
  1: ["معالي الوزير"],
  2: ["مستشار الوزير", "وكيل الوزارة للعلاقات الثنائية", "وكيل الوزارة للشؤون الادارية والفنية",
      "وكيل الوزارة للعلاقات المتعددة الاطراف والشؤون القانونية", "وكيل الوزارة للتخطيط السياسي"],
  3: ["رئيس الدائرة", "معاون رئيس الدائرة"],
  4: ["رئيس قسم"]
};

// تنظيف خفيف عند الحفظ: يزيل المحارف غير المرئية والفراغات الزائدة فقط،
// دون تغيير الحروف العربية نفسها (حتى لا يُشوَّه النص المعروض/المطبوع).
function cleanText_(s) {
  if (s === null || s === undefined) return '';
  return String(s)
    .replace(/[\u200B\u200C\u200D\u200E\u200F\uFEFF]/g, '')
    .trim()
    .replace(/\s+/g, ' ');
}

// تطبيع أعمق للمقارنة فقط (تصنيف الأقسام، فحص التكرار، البحث بالرقم المرجعي) —
// يوحّد أشكال الحروف العربية المتقاربة حتى لا يفشل التطابق بسبب فروق إملائية
// بسيطة. لا يُستخدم أبداً لتخزين أو عرض النص الفعلي.
function normalizeText_(s) {
  if (s === null || s === undefined) return '';
  return String(s)
    .replace(/[\u200B\u200C\u200D\u200E\u200F\uFEFF]/g, '') // محارف اتجاه/عرض صفري
    .replace(/[\u064B-\u065F\u0670]/g, '') // التشكيل
    .replace(/\u0640/g, '') // التطويل
    .replace(/[إأآا]/g, 'ا')
    .replace(/ى/g, 'ي')
    .replace(/ة/g, 'ه')
    .trim()
    .replace(/\s+/g, ' ');
}

// يحوّل الأرقام الغربية إلى أرقام هندية للعرض في المستندات المُصدَّرة
function toEasternDigits_(s) {
  var map = { '0':'٠','1':'١','2':'٢','3':'٣','4':'٤','5':'٥','6':'٦','7':'٧','8':'٨','9':'٩' };
  return String(s).replace(/[0-9]/g, function (d) { return map[d]; });
}

function classifySection_(hostTitle, category) {
  if (category) {
    var normalizedCategory = normalizeText_(category);
    for (var c = 1; c <= 4; c++) {
      if (normalizeText_(CATEGORY_LABELS[c]) === normalizedCategory) return c;
    }
  }
  var normalized = normalizeText_(hostTitle);
  for (var i = 1; i <= 3; i++) {
    for (var j = 0; j < SECTION_TITLES[i].length; j++) {
      if (normalizeText_(SECTION_TITLES[i][j]) === normalized) return i;
    }
  }
  return 4;
}

/* ============================================================
   نقطة الدخول: عرض الصفحة
   ============================================================ */
function doGet(e) {
  return ContentService.createTextOutput(JSON.stringify({ ok: true, message: 'الخادم يعمل. افتح رابط الموقع الرئيسي للاستخدام.' }))
    .setMimeType(ContentService.MimeType.JSON);
}

/* ============================================================
   نقطة الوصول الموحّدة للواجهة الخارجية (المستضافة على GitHub Pages)
   الواجهة ترسل: { action: 'اسم الدالة', params: [قيمة1, قيمة2, ...] }
   وتستقبل دائماً: { ok:true, result:... } أو { ok:false, error:'...' }
   ============================================================ */
function ping() { return { alive: true, time: new Date().toISOString() }; }

var API_ACTIONS = {
  ping: ping,
  getOptions: getOptions,
  submitRequest: submitRequest,
  getRequestByCode: getRequestByCode,
  searchByNameDate: searchByNameDate,
  checkTimeConflict: checkTimeConflict,
  adminLogin: adminLogin,
  adminListAll: adminListAll,
  adminUpdateRequest: adminUpdateRequest,
  adminDeleteRequest: adminDeleteRequest,
  adminRemoveOption: adminRemoveOption,
  adminClearAllRequests: adminClearAllRequests,
  adminGetDailySchedule: adminGetDailySchedule,
  adminExportScheduleFile: adminExportScheduleFile
};

function doPost(e) {
  var response;
  try {
    var body = JSON.parse(e.postData.contents);
    var fn = API_ACTIONS[body.action];
    if (!fn) throw new Error('إجراء غير معروف: ' + body.action);
    var result = fn.apply(null, body.params || []);
    response = { ok: true, result: result };
  } catch (err) {
    response = { ok: false, error: err.message };
  }
  return ContentService.createTextOutput(JSON.stringify(response)).setMimeType(ContentService.MimeType.JSON);
}

/* ============================================================
   أدوات الجداول (Sheets)
   ============================================================ */
function ss_() {
  return SpreadsheetApp.getActiveSpreadsheet();
}

function ensureSheets_() {
  var ss = ss_();
  var req = ss.getSheetByName(REQUESTS_SHEET);
  if (!req) {
    req = ss.insertSheet(REQUESTS_SHEET);
    req.appendRow(['code','department','hostTitle','host','guests','date','time',
                    'durationValue','durationUnit','submittedAt','status','location','updatedAt',
                    'securityInfoSent','officialLetterSent','departmentPledge','clientRequestId',
                    'category','applicantName','phone','attendeeCount']);
    req.setFrozenRows(1);
  } else {
    if (req.getLastColumn() < 16) {
      // توافق مع الجداول المُنشأة قبل إضافة خيارات التأشير: نضيف عناوين الأعمدة الجديدة فقط
      req.getRange(1, 14, 1, 3).setValues([['securityInfoSent', 'officialLetterSent', 'departmentPledge']]);
    }
    if (req.getLastColumn() < 17) {
      // توافق مع الجداول المُنشأة قبل إضافة حماية إعادة المحاولة الآمنة
      req.getRange(1, 17).setValue('clientRequestId');
    }
    if (req.getLastColumn() < 18) req.getRange(1, 18).setValue('category');
    if (req.getLastColumn() < 19) req.getRange(1, 19).setValue('applicantName');
    if (req.getLastColumn() < 20) req.getRange(1, 20).setValue('phone');
    if (req.getLastColumn() < 21) req.getRange(1, 21).setValue('attendeeCount');
  }
  var opt = ss.getSheetByName(OPTIONS_SHEET);
  if (!opt) {
    opt = ss.insertSheet(OPTIONS_SHEET);
    opt.appendRow(['category', 'value']);
    opt.setFrozenRows(1);
    DEFAULT_HOST_TITLES.forEach(function (v) {
      opt.appendRow(['hostTitle', v]);
    });
    DEFAULT_ROOMS.forEach(function (v) {
      opt.appendRow(['room', v]);
    });
  } else {
    // توافق مع الجداول المُنشأة قبل إضافة ميزة القاعات: نزرع القيم الافتراضية
    // إذا لم تكن موجودة بعد، دون التأثير على أي قيم أضافها المستخدم يدوياً.
    var existingCats = opt.getDataRange().getValues().slice(1).map(function (r) { return r[0]; });
    if (existingCats.indexOf('room') === -1) {
      DEFAULT_ROOMS.forEach(function (v) {
        opt.appendRow(['room', v]);
      });
    }
  }
  return { req: req, opt: opt };
}

/* ============================================================
   القوائم المنسدلة (تنمو مع الاستخدام)
   ============================================================ */
function getOptions() {
  var cache = CacheService.getScriptCache();
  var cached = cache.get('mofa_options_v2');
  if (cached) {
    try { return JSON.parse(cached); } catch (e) {}
  }
  var sheets = ensureSheets_();
  var lastRow = sheets.opt.getLastRow();
  var data = lastRow > 1 ? sheets.opt.getRange(1, 1, lastRow, 2).getValues() : [['category','value']];
  var out = { department: [], hostTitle: [], host: [], guest: [], guestRole: [], room: [] };
  for (var i = 1; i < data.length; i++) {
    var cat = data[i][0], val = cleanText_(data[i][1]);
    if (out[cat] && val) out[cat].push(val);
  }
  try { cache.put('mofa_options_v2', JSON.stringify(out), 600); } catch (e2) {}
  return out;
}

function addOptionIfNew_(category, value) {
  if (!value) return;
  var cleanValue = cleanText_(value);
  if (!cleanValue) return;
  var comparisonKey = normalizeText_(cleanValue);
  var sheets = ensureSheets_();
  var lastRow = sheets.opt.getLastRow();
  var data = lastRow > 1 ? sheets.opt.getRange(1, 1, lastRow, 2).getValues() : [];
  for (var i = 0; i < data.length; i++) {
    if (data[i][0] === category && normalizeText_(data[i][1]) === comparisonKey) return;
  }
  sheets.opt.appendRow([category, cleanValue]);
  try { CacheService.getScriptCache().remove('mofa_options_v2'); } catch (e) {}
}

/* ============================================================
   إنشاء رقم طلب فريد
   ============================================================ */
function generateUniqueCode_() {
  var sheets = ensureSheets_();
  var lastRow = sheets.req.getLastRow();
  var existing = [];
  if (lastRow > 1) {
    existing = sheets.req.getRange(2, 1, lastRow - 1, 1).getValues().map(function (r) { return normalizeText_(r[0]); });
  }
  for (var i = 0; i < 20; i++) {
    var num = Math.floor(100000 + Math.random() * 900000); // رقم من 6 خانات
    var code = 'M' + num;
    if (existing.indexOf(normalizeText_(code)) === -1) return code;
  }
  return 'M' + Date.now();
}

/* ============================================================
   ترميز/تفكيك الضيوف (كل ضيف = صفة اختيارية + اسم)
   يُخزَّن كل ضيف كـ "الصفة::الاسم" ثم تُفصل عدة ضيوف بـ "، "
   ============================================================ */
function encodeGuests_(guests) {
  return guests.map(function (g) { return (g.role || '') + '::' + g.name; }).join('، ');
}
function parseGuests_(str) {
  if (!str) return [];
  return String(str).split('، ').map(function (part) {
    var idx = part.indexOf('::');
    if (idx === -1) return { role: '', name: part }; // توافق مع بيانات قديمة بلا صفة
    return { role: part.substring(0, idx), name: part.substring(idx + 2) };
  }).filter(function (g) { return g.name; });
}
function displayGuest_(g) {
  return g.role ? (g.role + ' ' + g.name) : g.name;
}

/* ============================================================
   التحقق من صحة الطلب (يُنفَّذ على الخادم دوماً، لا يُعتمد على العميل فقط)
   ============================================================ */
function isTextFieldValid_(value) {
  // العربية والإنجليزية مع المسافات، والشرطة/الفاصلة العليا عند الحاجة في الأسماء الأجنبية.
  return /^[A-Za-z\u0600-\u06FF\u0750-\u077F]+(?:[ .'\-][A-Za-z\u0600-\u06FF\u0750-\u077F]+)*$/.test(String(value || '').trim());
}
function isDigitsOnly_(value) {
  return /^\d+$/.test(String(value || '').trim());
}
function canonicalValue_(value) {
  return normalizeText_(cleanText_(value)).toLowerCase();
}
function buildDuplicateKey_(p) {
  var guests = (p.guests || []).map(function(g) {
    return canonicalValue_(g.role) + '|' + canonicalValue_(g.name);
  }).join('||');
  return [
    canonicalValue_(p.category),
    canonicalValue_(p.department),
    canonicalValue_(p.hostTitle),
    canonicalValue_(p.host),
    guests,
    String(p.date || '').trim(),
    String(p.time || '').trim(),
    String(p.durationValue || '').trim(),
    String(p.durationUnit || '').trim(),
    canonicalValue_(p.applicantName),
    String(p.phone || '').replace(/\D/g, ''),
    String(p.attendeeCount || '').trim()
  ].join('¦');
}

function validateRequest_(p) {
  var errors = [];
  if (!CATEGORY_VALUES.some(function(v) { return normalizeText_(v) === normalizeText_(p.category); }))
    errors.push('يرجى اختيار فئة الأولوية الرسمية.');
  if (!p.department || !isTextFieldValid_(p.department)) errors.push('اسم الدائرة: أدخل أحرفاً عربية أو إنجليزية ومسافات فقط.');
  if (!p.hostTitle || !isTextFieldValid_(p.hostTitle)) errors.push('صفة المستقبِل: أدخل أحرفاً عربية أو إنجليزية ومسافات فقط.');
  if (!p.host || !isTextFieldValid_(p.host)) errors.push('اسم المضيف: أدخل أحرفاً عربية أو إنجليزية ومسافات فقط.');
  var guestNames = (p.guests || []).filter(function (g) { return g && g.name; });
  if (guestNames.length === 0) errors.push('يرجى إدخال اسم ضيف واحد على الأقل.');
  guestNames.forEach(function(g) {
    if (!isTextFieldValid_(g.name)) errors.push('اسم الضيف يجب أن يحتوي على أحرف عربية أو إنجليزية ومسافات فقط.');
    if (g.role && !isTextFieldValid_(g.role)) errors.push('صفة/جهة الضيف يجب أن تحتوي على أحرف عربية أو إنجليزية ومسافات فقط.');
  });
  if (!p.applicantName || !isTextFieldValid_(p.applicantName)) errors.push('اسم مقدم الطلب: أدخل أحرفاً عربية أو إنجليزية ومسافات فقط.');
  if (!p.phone || !isDigitsOnly_(p.phone)) errors.push('رقم الهاتف: أدخل أرقاماً فقط.');
  if (!p.attendeeCount || !isDigitsOnly_(p.attendeeCount) || Number(p.attendeeCount) < 1) errors.push('عدد الحضور: أدخل رقماً صحيحاً أكبر من صفر.');
  if (!p.date) errors.push('يرجى اختيار تاريخ اللقاء.');
  if (!p.time) errors.push('يرجى اختيار وقت اللقاء.');
  if (!p.durationValue || p.durationValue <= 0) errors.push('يرجى إدخال مدة لقاء صحيحة.');

  if (p.date) {
    var day = new Date(p.date + 'T00:00:00').getDay();
    if (WORK_DAYS.indexOf(day) === -1) {
      errors.push('التاريخ المختار يوافق يوم إجازة رسمية. يرجى اختيار يوم من الأحد إلى الخميس.');
    }
  }
  if (p.time) {
    var parts = p.time.split(':');
    if (parts.length !== 2 || isNaN(Number(parts[0])) || isNaN(Number(parts[1]))) {
      errors.push('وقت اللقاء غير صالح.');
    } else {
      var startMin = Number(parts[0]) * 60 + Number(parts[1]);
      if (startMin < OPEN_MINUTES || startMin >= CLOSE_MINUTES) {
        errors.push('وقت اللقاء يجب أن يكون ضمن الدوام الرسمي (٨:٠٠ صباحاً حتى ٢:٠٠ ظهراً).');
      } else if (p.durationValue > 0) {
        var durMin = p.durationUnit === 'hours' ? p.durationValue * 60 : p.durationValue;
        if (startMin + durMin > CLOSE_MINUTES) {
          errors.push('مدة اللقاء تتجاوز نهاية الدوام الرسمي (٢:٠٠ ظهراً). يرجى تقصير المدة أو اختيار وقت أبكر.');
        }
      }
    }
  }
  return errors;
}

/* ============================================================
   التحقق من تعارض الأوقات (تنبيه غير مانع للطلب)
   ============================================================ */
function checkTimeConflict(date, time, durationValue, durationUnit) {
  if (!date || !time || !durationValue) return [];
  var data = getRequestsDataCached_(date);
  var parts = time.split(':');
  var newStart = Number(parts[0]) * 60 + Number(parts[1]);
  var newDur = durationUnit === 'hours' ? durationValue * 60 : durationValue;
  var newEnd = newStart + newDur;

  var conflicts = [];
  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    if (normalizeDate_(row[5]) !== date) continue;
    if (row[10] === 'rejected') continue; // الوقت المعتذر عنه أصبح متاحاً من جديد
    var existingTime = normalizeTime_(row[6]);
    var existParts = existingTime.split(':');
    var existStart = Number(existParts[0]) * 60 + Number(existParts[1]);
    var existDur = row[8] === 'hours' ? row[7] * 60 : row[7];
    var existEnd = existStart + existDur;
    if (newStart < existEnd && existStart < newEnd) {
      conflicts.push({ time: existingTime, durationValue: row[7], durationUnit: row[8], status: row[10] });
    }
  }
  return conflicts;
}

/* ============================================================
   فحص وجود حجز سابق في اليوم نفسه (تنبيه غير مانع)
   لا يشمل الطلبات المعتذر عنها. التكرار المطابق تماماً يُفحص
   أولاً في submitRequest ويُرفض قبل الوصول إلى هذا التنبيه.
   ============================================================ */
function hasActiveBookingOnDate_(date) {
  if (!date) return false;
  var cache = CacheService.getScriptCache();
  var cacheKey = 'mofa_day_' + String(date).replace(/[^0-9]/g, '');
  var cached = cache.get(cacheKey);
  if (cached === '1') return true;
  if (cached === '0') return false;

  var sheets = ensureSheets_();
  var lastRow = sheets.req.getLastRow();
  if (lastRow < 2) return false;
  // التاريخ = العمود F، الحالة = العمود K. نقرأ هذين العمودين فقط.
  var data = sheets.req.getRange(2, 6, lastRow - 1, 6).getValues();
  for (var i = 0; i < data.length; i++) {
    if (normalizeDate_(data[i][0]) === date && data[i][5] !== 'rejected') {
      try { cache.put(cacheKey, '1', 120); } catch (e) {}
      return true;
    }
  }
  try { cache.put(cacheKey, '0', 120); } catch (e2) {}
  return false;
}

/* ============================================================
   إرسال طلب جديد
   ============================================================ */
function submitRequest(payload) {
  var sheets = ensureSheets_();
  payload = payload || {};

  // حماية إعادة المحاولة بنفس معرّف العميل.
  var clientRequestId = cleanText_(payload.clientRequestId);
  if (clientRequestId) {
    var existingRow = findByClientRequestId_(clientRequestId);
    if (existingRow) return { ok: true, request: rowToRequest_(existingRow) };
  }

  var errors = validateRequest_(payload);
  if (errors.length > 0) return { ok: false, errors: errors };

  var category = cleanText_(payload.category);
  var department = cleanText_(payload.department);
  var hostTitle = cleanText_(payload.hostTitle);
  var host = cleanText_(payload.host);
  var applicantName = cleanText_(payload.applicantName);
  var phone = cleanText_(payload.phone);
  var attendeeCount = cleanText_(payload.attendeeCount);
  var guests = (payload.guests || [])
    .map(function (g) { return { role: cleanText_(g.role), name: cleanText_(g.name) }; })
    .filter(function (g) { return g && g.name; });

  payload.category = category;
  payload.department = department;
  payload.hostTitle = hostTitle;
  payload.host = host;
  payload.applicantName = applicantName;
  payload.phone = phone;
  payload.attendeeCount = attendeeCount;
  payload.guests = guests;

  var duplicateKey = buildDuplicateKey_(payload);
  // قفل قصير يمنع سباق طلبين متطابقين في اللحظة نفسها.
  var lock = LockService.getScriptLock();
  lock.waitLock(5000);
  try {
    var duplicate = findByDuplicateKey_(duplicateKey);
    if (duplicate) return { ok: false, errors: ['تم هذا الحجز مسبقاً'] };

    var sameDayBooking = hasActiveBookingOnDate_(payload.date);
    var code = generateUniqueCode_();
    var now = new Date().toISOString();
    var guestsJoined = encodeGuests_(guests);

    sheets.req.appendRow([
      code, department, hostTitle, host, guestsJoined,
      payload.date, payload.time, payload.durationValue, payload.durationUnit,
      now, 'pending', '', '',
      !!payload.securityInfoSent, !!payload.officialLetterSent, !!payload.departmentPledge,
      clientRequestId, category, applicantName, phone, attendeeCount
    ]);

    addOptionIfNew_('department', department);
    addOptionIfNew_('hostTitle', hostTitle);
    addOptionIfNew_('host', host);
    guests.forEach(function (g) {
      if (g.role) addOptionIfNew_('guestRole', g.role);
    });
    invalidateRequestCaches_(payload.date);
    try { CacheService.getScriptCache().put('mofa_day_' + String(payload.date).replace(/[^0-9]/g, ''), '1', 120); } catch (cacheErr) {}
    // فهرسة معرّف العميل والتكرار المطابق لتسريع إعادة الإرسال والطلبات التالية.
    try {
      var requestCache = CacheService.getScriptCache();
      if (clientRequestId) {
        var clientKey = 'mofa_client_' + Utilities.base64EncodeWebSafe(String(clientRequestId)).replace(/=+$/,'').slice(0,90);
        requestCache.put(clientKey, String(code), 21600);
      }
      requestCache.put(duplicateCacheKey_(duplicateKey), String(code), 21600);
    } catch (cacheErr2) {}

    return {
      ok: true,
      sameDayWarning: sameDayBooking,
      request: rowToRequest_([code, department, hostTitle, host, guestsJoined,
        payload.date, payload.time, payload.durationValue, payload.durationUnit, now, 'pending', '', '',
        !!payload.securityInfoSent, !!payload.officialLetterSent, !!payload.departmentPledge,
        clientRequestId, category, applicantName, phone, attendeeCount])
    };
  } finally {
    lock.releaseLock();
  }
}

/* ============================================================
   تطبيع التاريخ والوقت المقروء من الجدول
   سبب الخطأ: يحوّل Google Sheets تلقائياً أي نص يشبه تاريخاً أو وقتاً
   (مثل "2026-09-10" أو "10:00") إلى كائن تاريخ فعلي عند تخزينه في الخلية،
   حتى لو أُدخل كنص عادي. هذا يكسر أي مقارنة نصية لاحقة (بحث، تصدير الجدول).
   الحل: إعادة أي قيمة مقروءة من الجدول إلى نص "YYYY-MM-DD" / "HH:MM" دائماً.
   ============================================================ */
function normalizeDate_(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    var y = value.getFullYear();
    var m = ('0' + (value.getMonth() + 1)).slice(-2);
    var d = ('0' + value.getDate()).slice(-2);
    return y + '-' + m + '-' + d;
  }
  return value;
}
function normalizeTime_(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    var h = ('0' + value.getHours()).slice(-2);
    var m = ('0' + value.getMinutes()).slice(-2);
    return h + ':' + m;
  }
  return value;
}

function rowToRequest_(row) {
  return {
    code: row[0], department: row[1], hostTitle: row[2], host: row[3],
    guests: parseGuests_(row[4]),
    date: normalizeDate_(row[5]), time: normalizeTime_(row[6]), durationValue: row[7], durationUnit: row[8],
    submittedAt: row[9], status: row[10], location: row[11], updatedAt: row[12],
    securityInfoSent: !!row[13], officialLetterSent: !!row[14], departmentPledge: !!row[15],
    category: row[17] || CATEGORY_LABELS[classifySection_(row[2])],
    applicantName: row[18] || '', phone: row[19] || '', attendeeCount: row[20] || ''
  };
}

function findRow_(code) {
  var sheets = ensureSheets_();
  var lastRow = sheets.req.getLastRow();
  if (lastRow < 2) return null;
  var target = normalizeText_(code);
  var codes = sheets.req.getRange(2, 1, lastRow - 1, 1).getValues();
  for (var i = 0; i < codes.length; i++) {
    if (normalizeText_(codes[i][0]) === target) {
      return { rowIndex: i + 2, row: sheets.req.getRange(i + 2, 1, 1, Math.max(21, sheets.req.getLastColumn())).getValues()[0] };
    }
  }
  return null;
}

// يبحث عن طلب سبق إنشاؤه بنفس معرّف العميل (clientRequestId)، لمنع تكرار الحجز
// عند إعادة المحاولة تلقائياً بعد انقطاع مؤقت في الاتصال بالخادم.
function findByClientRequestId_(clientRequestId) {
  if (!clientRequestId) return null;
  var cache = CacheService.getScriptCache();
  var cacheKey = 'mofa_client_' + Utilities.base64EncodeWebSafe(String(clientRequestId)).replace(/=+$/,'').slice(0,90);
  var cachedCode = cache.get(cacheKey);
  if (cachedCode) {
    var cachedFound = findRow_(cachedCode);
    if (cachedFound) return cachedFound.row;
  }
  var sheets = ensureSheets_();
  var lastRow = sheets.req.getLastRow();
  if (lastRow < 2) return null;
  var ids = sheets.req.getRange(2, 17, lastRow - 1, 1).getValues();
  var target = normalizeText_(clientRequestId);
  for (var i = 0; i < ids.length; i++) {
    if (ids[i][0] && normalizeText_(ids[i][0]) === target) {
      var row = sheets.req.getRange(i + 2, 1, 1, Math.max(21, sheets.req.getLastColumn())).getValues()[0];
      try { cache.put(cacheKey, String(row[0]), 21600); } catch (e) {}
      return row;
    }
  }
  return null;
}

function duplicateCacheKey_(duplicateKey) {
  var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(duplicateKey), Utilities.Charset.UTF_8);
  return 'mofa_dup_' + Utilities.base64EncodeWebSafe(digest).replace(/=+$/,'').slice(0,90);
}

function findByDuplicateKey_(duplicateKey) {
  if (!duplicateKey) return null;
  var cache = CacheService.getScriptCache();
  var cacheKey = duplicateCacheKey_(duplicateKey);
  var cachedCode = cache.get(cacheKey);
  if (cachedCode) {
    var cachedFound = findRow_(cachedCode);
    if (cachedFound && cachedFound.row[10] !== 'rejected') return cachedFound.row;
  }

  var sheets = ensureSheets_();
  var lastRow = sheets.req.getLastRow();
  if (lastRow < 2) return null;
  // نقرأ فقط الأعمدة اللازمة لبناء مفتاح التكرار، بدلاً من قراءة الورقة كلها.
  var data = sheets.req.getRange(2, 2, lastRow - 1, 20).getValues();
  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    if (row[9] === 'rejected') continue; // B:U => status هو العمود J داخل هذه المصفوفة
    var rowKey = buildDuplicateKey_({
      department: row[0], hostTitle: row[1], host: row[2], guests: parseGuests_(row[3]),
      date: normalizeDate_(row[4]), time: normalizeTime_(row[5]), durationValue: row[6], durationUnit: row[7],
      applicantName: row[17], phone: row[18], attendeeCount: row[19],
      category: row[16] || CATEGORY_LABELS[classifySection_(row[1])]
    });
    if (rowKey === duplicateKey) {
      var fullRow = sheets.req.getRange(i + 2, 1, 1, Math.max(21, sheets.req.getLastColumn())).getValues()[0];
      try { cache.put(cacheKey, String(fullRow[0]), 21600); } catch (e) {}
      return fullRow;
    }
  }
  return null;
}
function invalidateRequestCaches_(date) {
  try {
    var cache = CacheService.getScriptCache();
    if (date) cache.remove('mofa_requests_' + date);
    cache.remove('mofa_options_v2');
  } catch (e) {}
}
function getRequestsDataCached_(date) {
  var cache = CacheService.getScriptCache();
  var key = date ? 'mofa_requests_' + date : 'mofa_requests_all_v2';
  var cached = cache.get(key);
  if (cached) {
    try { return JSON.parse(cached); } catch (e) {}
  }
  var sheets = ensureSheets_();
  var raw = sheets.req.getDataRange().getValues();
  var values = [];
  for (var i = 0; i < raw.length; i++) {
    if (i === 0) {
      values.push(raw[i]);
      continue;
    }
    if (date && normalizeDate_(raw[i][5]) !== date) continue;
    var row = raw[i].slice();
    row[5] = normalizeDate_(row[5]);
    row[6] = normalizeTime_(row[6]);
    values.push(row);
  }
  try { cache.put(key, JSON.stringify(values), 120); } catch (e2) {}
  return values;
}

/* ============================================================
   المتابعة برقم الطلب (تفاصيل كاملة — امتلاك الرقم يُثبت الصفة)
   ============================================================ */
function getRequestByCode(code) {
  var found = findRow_(code);
  return found ? rowToRequest_(found.row) : null;
}

/* ============================================================
   المتابعة بالاسم والتاريخ (تفاصيل مُخفاة أمنياً — لا تُعيد أسماء الأشخاص)
   ============================================================ */
function searchByNameDate(name, date) {
  var sheets = ensureSheets_();
  var lastRow = sheets.req.getLastRow();
  if (lastRow < 2) return [];
  var width = Math.max(21, sheets.req.getLastColumn());
  var data = sheets.req.getRange(2, 1, lastRow - 1, width).getValues();
  var targetName = String(name || '').trim();
  var out = [];
  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var guests = parseGuests_(row[4]);
    var matched = guests.some(function (g) { return g.name.indexOf(targetName) !== -1; });
    if (normalizeDate_(row[5]) === date && matched) {
      out.push(rowToRequest_(row));
    }
  }
  return out;
}

/* ============================================================
   لوحة الإدارة — كل دالة تتحقق من كلمة المرور بنفسها في كل استدعاء
   ============================================================ */
function getAdminPassword_() {
  return PropertiesService.getScriptProperties().getProperty(ADMIN_PASSWORD_PROPERTY) || '';
}
function checkAdmin_(password) {
  var stored = getAdminPassword_();
  return !!stored && String(password || '') === stored;
}

function adminLogin(password) {
  return checkAdmin_(password);
}

function adminListAll(password) {
  if (!checkAdmin_(password)) return { ok: false, error: 'كلمة المرور غير صحيحة.' };
  var sheets = ensureSheets_();
  var data = getRequestsDataCached_(null);
  var out = [];
  for (var i = 1; i < data.length; i++) out.push(rowToRequest_(data[i]));
  out.sort(function (a, b) { return new Date(b.submittedAt) - new Date(a.submittedAt); });
  return { ok: true, requests: out };
}

/* ============================================================
   تصدير جدول المواعيد اليومي الرسمي (مقسّم إلى 4 أقسام)
   ============================================================ */
function buildScheduleData_(date, statusFilter) {
  var sheets = ensureSheets_();
  var data = getRequestsDataCached_(date);
  var sections = { 1: [], 2: [], 3: [], 4: [] };

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    if (normalizeDate_(row[5]) !== date) continue;
    if (statusFilter === 'confirmed' && row[10] !== 'confirmed') continue;

    var guests = parseGuests_(row[4]);
    var sec = classifySection_(row[2], row[17]);
    sections[sec].push({
      time: normalizeTime_(row[6]),
      durationValue: row[7],
      durationUnit: row[8],
      host: (row[2] ? row[2] + ' ' : '') + (row[3] || ''),
      guestsDisplay: guests.map(displayGuest_).join('، '),
      location: row[11] || '',
      status: row[10]
    });
  }

  [1, 2, 3, 4].forEach(function (k) {
    sections[k].sort(function (a, b) { return String(a.time).localeCompare(String(b.time)); });
  });

  return sections;
}

function adminGetDailySchedule(password, date, statusFilter) {
  if (!checkAdmin_(password)) return { ok: false, error: 'كلمة المرور غير صحيحة.' };
  return { ok: true, date: date, sections: buildScheduleData_(date, statusFilter) };
}

var SECTION_EXPORT_TITLES = {
  1: 'مواعيد معالي الوزير',
  2: 'مواعيد السادة وكلاء الوزارة ومستشاري السيد الوزير',
  3: 'مواعيد السادة رؤساء دوائر الوزارة ومعاونيهم',
  4: 'مواعيد السادة مدراء الاقسام وموظفي الوزارة'
};

function formatTimeRange_(time, durationValue, durationUnit) {
  var parts = time.split(':');
  var startMin = Number(parts[0]) * 60 + Number(parts[1]);
  var durMin = durationUnit === 'hours' ? durationValue * 60 : durationValue;
  var endMin = startMin + durMin;
  function fmt(min) {
    var h = Math.floor(min / 60), m = min % 60;
    var suffix = h < 12 ? 'ص' : 'م';
    var h12 = h % 12; if (h12 === 0) h12 = 12;
    return h12 + ':' + ('0' + m).slice(-2) + ' ' + suffix;
  }
  return fmt(startMin) + ' – ' + fmt(endMin);
}

function weekdayNameAr_(dateStr) {
  var names = ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
  return names[new Date(dateStr + 'T00:00:00').getDay()];
}

/* ============================================================
   تصدير الجدول اليومي كملف PDF أو Word حقيقي قابل للتنزيل
   يتطلب صلاحيات إضافية (Docs/Drive) عند أول استخدام بعد النشر.
   ============================================================ */
function adminExportScheduleFile(password, date, statusFilter, format) {
  if (!checkAdmin_(password)) return { ok: false, error: 'كلمة المرور غير صحيحة.' };
  var sections = buildScheduleData_(date, statusFilter);
  var doc = DocumentApp.create('جدول-مواعيد-مؤقت-' + date);
  var body = doc.getBody();
  body.clear();

  try {
    var imageBlob = Utilities.newBlob(Utilities.base64Decode(LETTERHEAD_PNG_B64), 'image/png', 'letterhead.png');
    var imgPara = body.appendImage(imageBlob);
    var imgParent = imgPara.getParentElement().asParagraph();
    imgParent.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
    var currentWidth = imgPara.getWidth();
    var maxWidth = 380;
    if (currentWidth > maxWidth) {
      imgPara.setWidth(maxWidth);
      imgPara.setHeight(Math.round(imgPara.getHeight() * (maxWidth / currentWidth)));
    }
  } catch (imgErr) {
    // إن تعذّر إدراج الصورة لأي سبب، نتابع بدونها بدل فشل التصدير بالكامل
  }

  var titleText = 'جدول مواعيد يوم ' + weekdayNameAr_(date) + ' ' + toEasternDigits_(date);
  var titlePara = body.appendParagraph(titleText);
  titlePara.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  titlePara.setLeftToRight(false);
  titlePara.editAsText().setBold(true).setFontSize(15);

  [1, 2, 3, 4].forEach(function (secNum) {
    var headingText = (secNum === 4 ? '٤' : ['', '١', '٢', '٣'][secNum]) + '. ' + SECTION_EXPORT_TITLES[secNum] + ': -';
    var heading = body.appendParagraph(headingText);
    heading.setLeftToRight(false);
    heading.setAlignment(DocumentApp.HorizontalAlignment.RIGHT);
    heading.editAsText().setBold(true).setFontSize(12);

    var showResponsible = true;
    // ترتيب الأعمدة من اليسار إلى اليمين فعلياً كما تُنشئه Google Docs: القاعة أولاً (أقصى اليسار)
    // وصولاً إلى الوقت أخيراً (أقصى اليمين)، ليطابق الترتيب المرئي الصحيح للقارئ العربي.
    var headerRow = ['القاعة', 'الضيف', 'المسؤول', 'الوقت'];
    // عرض أوسع لعمودي المسؤول والضيف، وأضيق لعمودي الوقت والقاعة (بالنقاط pt)
    var colWidths = [70, 150, 150, 80];
    var rows = sections[secNum];
    var tableData = [headerRow];

    if (rows.length === 0) {
      tableData.push(headerRow.map(function () { return ''; }));
    } else {
      rows.forEach(function (r) {
        var timeRange = toEasternDigits_(formatTimeRange_(r.time, r.durationValue, r.durationUnit));
        if (showResponsible) {
          tableData.push([r.location || '', r.guestsDisplay || '', r.host || '', timeRange]);
        } else {
          tableData.push([r.location || '', r.guestsDisplay || '', timeRange]);
        }
      });
    }

    var table = body.appendTable(tableData);
    for (var w = 0; w < colWidths.length; w++) {
      table.setColumnWidth(w, colWidths[w]);
    }
    for (var rIdx = 0; rIdx < table.getNumRows(); rIdx++) {
      var tableRow = table.getRow(rIdx);
      for (var cIdx = 0; cIdx < tableRow.getNumCells(); cIdx++) {
        var cell = tableRow.getCell(cIdx);
        var cellPara = cell.getChild(0).asParagraph();
        cellPara.setLeftToRight(false);
        cellPara.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
        if (rIdx === 0) {
          cell.setBackgroundColor('#B4C7E7');
          cellPara.editAsText().setBold(true);
        }
      }
    }
    body.appendParagraph('').setFontSize(4); // مسافة صغيرة بين الأقسام
  });

  var sig = body.appendParagraph('');
  sig.setSpacingBefore(36);
  var sigLine = body.appendParagraph('____________________________');
  sigLine.setAlignment(DocumentApp.HorizontalAlignment.LEFT);
  sigLine.setLeftToRight(false);
  var sigTitle = body.appendParagraph('توقيع معاون رئيس الدائرة');
  sigTitle.setAlignment(DocumentApp.HorizontalAlignment.LEFT);
  sigTitle.setLeftToRight(false);
  var sigDate = body.appendParagraph('التاريخ: ' + toEasternDigits_(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy')));
  sigDate.setAlignment(DocumentApp.HorizontalAlignment.LEFT);
  sigDate.setLeftToRight(false);

  doc.saveAndClose();

  var exportFormat = format === 'docx' ? 'docx' : 'pdf';
  var exportUrl = 'https://docs.google.com/document/d/' + doc.getId() + '/export?format=' + exportFormat;
  var token = ScriptApp.getOAuthToken();
  var response = UrlFetchApp.fetch(exportUrl, { headers: { Authorization: 'Bearer ' + token } });
  var fileBlob = response.getBlob();
  var base64 = Utilities.base64Encode(fileBlob.getBytes());

  try { DriveApp.getFileById(doc.getId()).setTrashed(true); } catch (delErr) { /* تجاهل: التنظيف غير حرج */ }

  var mimeType = exportFormat === 'docx'
    ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
    : 'application/pdf';
  return {
    ok: true,
    base64: base64,
    filename: 'جدول-مواعيد-' + date + '.' + exportFormat,
    mimeType: mimeType
  };
}

function adminUpdateRequest(password, code, status, location) {
  if (!checkAdmin_(password)) return { ok: false, error: 'كلمة المرور غير صحيحة.' };
  var found = findRow_(code);
  if (!found) return { ok: false, error: 'الطلب غير موجود.' };
  var cleanLocation = cleanText_(location);
  var sheets = ensureSheets_();
  sheets.req.getRange(found.rowIndex, 11).setValue(status);
  sheets.req.getRange(found.rowIndex, 12).setValue(cleanLocation);
  sheets.req.getRange(found.rowIndex, 13).setValue(new Date().toISOString());
  if (cleanLocation) addOptionIfNew_('room', cleanLocation);
  invalidateRequestCaches_(normalizeDate_(found.row[5]));
  return { ok: true };
}

function adminRemoveOption(password, category, value) {
  if (!checkAdmin_(password)) return { ok: false, error: 'كلمة المرور غير صحيحة.' };
  var sheets = ensureSheets_();
  var data = sheets.opt.getDataRange().getValues();
  for (var i = data.length - 1; i >= 1; i--) {
    if (data[i][0] === category && data[i][1] === value) sheets.opt.deleteRow(i + 1);
  }
  return { ok: true };
}

function adminDeleteRequest(password, code) {
  if (!checkAdmin_(password)) return { ok: false, error: 'كلمة المرور غير صحيحة.' };
  var found = findRow_(code);
  if (!found) return { ok: false, error: 'الطلب غير موجود.' };
  var date = normalizeDate_(found.row[5]);
  var sheets = ensureSheets_();
  sheets.req.deleteRow(found.rowIndex);
  invalidateRequestCaches_(date);
  return { ok: true };
}

function adminClearAllRequests(password) {
  if (!checkAdmin_(password)) return { ok: false, error: 'كلمة المرور غير صحيحة.' };
  var sheets = ensureSheets_();
  var lastRow = sheets.req.getLastRow();
  if (lastRow > 1) sheets.req.getRange(2, 1, lastRow - 1, sheets.req.getLastColumn()).clearContent();
  try { CacheService.getScriptCache().removeAll(['mofa_requests_all_v2']); } catch (e) {}
  return { ok: true };
}
